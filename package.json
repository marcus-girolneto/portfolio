{
  "name": "marcus-girolneto-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "audit:performance": "node scripts/lighthouse.mjs",
    "check:links": "node scripts/check-links.mjs",
    "format": "prettier --write src tests scripts docs/*.md *.ts *.mjs README.md package.json",
    "format:check": "prettier --check src tests scripts docs/*.md next.config.ts playwright.config.ts vitest.config.ts tsconfig.json eslint.config.mjs postcss.config.mjs README.md package.json"
  },
  "dependencies": {
    "lucide-react": "^1.66.0",
    "motion": "^14.9.0",
    "next": "^16.4.4",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.4",
    "lighthouse": "^13.6.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "type": "module"
}
